---
import MainNav from '@components/MainNav.astro';
import { Image } from 'astro:assets';
import logo from '../assets/logo.svg';
import { SITE } from '@src/site';
---

<header class="site-header border-b border-slate-100 bg-white">
  <div class="container-fluid fl-py-5/10">
    <div class="fl-gap-5/10 flex flex-wrap items-center justify-between">
      <a href="/" class="font-semibold text-black">
        <Image src={logo} alt={`${SITE.title} home`} />
      </a>

      <MainNav />
    </div>
  </div>
</header>
